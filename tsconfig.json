{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "importHelpers": true,
    "noEmitHelpers": true,
    "strictNullChecks": false,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "removeComments": true,
    "stripInternal": true,
    "types": ["@webgpu/types"]
  },
  "include": ["src"]
}
