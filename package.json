{
  "name": "cozyecs",
  "version": "0.1.0",
  "description": "A tiny, fast archetype ECS for TypeScript and JavaScript: typed-array storage, zero dependencies, and systems that compile to WebGPU compute shaders.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.jest.json --rootDir .",
    "prepublishOnly": "npm run build",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "benchmark": "node benchmarks/benchmark.js",
    "benchmark:gpu": "node benchmarks/gpu.js"
  },
  "keywords": [
    "ecs",
    "entity-component-system",
    "archetype",
    "game-engine",
    "gamedev",
    "typed-arrays",
    "data-oriented",
    "webgpu",
    "wgsl",
    "gpu",
    "compute-shader",
    "typescript",
    "performance"
  ],
  "author": "M. Ergin Turk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RecursiveVoid/CozyECS.git"
  },
  "homepage": "https://github.com/RecursiveVoid/CozyECS#readme",
  "bugs": {
    "url": "https://github.com/RecursiveVoid/CozyECS/issues"
  },
  "devDependencies": {
    "@javelin/ecs": "^1.0.0-alpha.13",
    "@lastolivegames/becsy": "^0.15.5",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/benchmark": "^2.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "@webgpu/types": "^0.1.72",
    "benchmark": "^2.1.4",
    "bitecs": "^0.3.40",
    "bitecs4": "npm:bitecs@^0.4.0",
    "ecsy": "^0.4.3",
    "geotic": "^4.3.2",
    "harmony-ecs": "^0.0.12",
    "jest": "^29.7.0",
    "miniplex": "^2.0.0",
    "perform-ecs": "^0.7.8",
    "prettier": "^3.4.2",
    "rollup": "^4.27.4",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-strip": "^1.2.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "ts-jest": "^29.2.5",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "webgpu": "^0.6.1",
    "wolf-ecs": "^2.1.3"
  },
  "type": "module",
  "files": [
    "dist/",
    "!dist/__tests__/",
    "!dist/gpu/types/",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.js"
    },
    "./gpu": {
      "types": "./dist/gpu/index.d.ts",
      "require": "./dist/gpu/index.cjs",
      "import": "./dist/gpu/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    },
    "webgpu": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@webgpu/types": "^0.1.72",
    "webgpu": "^0.6.0"
  }
}
